from django.test import Client
from django.contrib.auth import get_user_model
from forms.models import FormPage, ContactPage
import csv, io
from wagtail.contrib.forms.models import FormSubmission
c = Client(); c.force_login(get_user_model().objects.get(username='admin'))
for page in [FormPage.objects.get(), ContactPage.objects.get()]:
    listing = c.get('/admin/forms/submissions/%d/' % page.pk).content.decode()
    missing = [s.pk for s in FormSubmission.objects.filter(page=page) if s.form_data[next(iter(s.form_data))] not in listing and not s.form_data[next(iter(s.form_data))] is None]
    r = c.get('/admin/forms/submissions/%d/?export=csv' % page.pk)
    rows = list(csv.reader(io.StringIO(b''.join(r.streaming_content).decode())))
    print(page.slug, 'submissions', FormSubmission.objects.filter(page=page).count(), '| CSV rows', len(rows)-1, '| CSV columns', len(rows[0]), '| empty cells', sum(1 for row in rows[1:] for cell in row if cell in ('', 'None')))

