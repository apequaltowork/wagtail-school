import os
from django.conf import settings
from wagtail.images import get_image_model
from wagtail.documents import get_document_model
Image = get_image_model(); Rendition = Image.get_rendition_model()
keep = set(i.file.name for i in Image.objects.all()) | set(r.file.name for r in Rendition.objects.all()) | set(d.file.name for d in get_document_model().objects.all())
removed = 0
for folder in ('original_images', 'images', 'documents'):
    root = os.path.join(settings.MEDIA_ROOT, folder)
    for name in os.listdir(root):
        rel = folder + '/' + name
        if rel not in keep:
            os.remove(os.path.join(root, name)); removed += 1
print('referenced files:', len(keep), ' removed unreferenced:', removed)
missing = [n for n in keep if not os.path.exists(os.path.join(settings.MEDIA_ROOT, n))]
print('referenced but missing:', len(missing))
